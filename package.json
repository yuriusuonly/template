{
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "bun": "bun ./scripts/bun.js",
    "bun:test": "bun ./scripts/bun.js test",
    "gh": "bun ./scripts/gh.js",
    "gh:secrets": "bun ./scripts/gh.js secret set -f ./.env",
    "git": "bun ./scripts/git.js",
    "git:push": "bun ./scripts/git.js push origin HEAD",
    "opencode": "bun ./scripts/opencode.js",
    "skill": "bun ./scripts/skill.js"
  },
  "allowScripts": {
    "@opencode/cli": true
  },
  "devDependencies": {
    "@opencode/cli": "^2.4.1",
    "skills": "^1.9.0"
  },
  "trustedDependencies": [
    "@opencode/cli"
  ]
}
