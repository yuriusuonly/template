{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "agent": {
    "0rchestrator": {
      "description": "Primary agent that orchestrates the entire project.",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "task": "allow",
        "external_directory": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "doom_loop": "ask",
        "skill": "allow"
      }
    }
  },
  "default_agent": "0rchestrator",
  "instructions": [
    "AGENTS.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true
  },
  "snapshot": true
}
